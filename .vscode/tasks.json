{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build current C file (Debug)",
            "type": "process",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build",
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DDEBUG_SOURCE=${file}"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Compile current C file (Debug)",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build",
                "--target",
                "debug_current",
                "--config",
                "Debug"
            ],
            "dependsOn": "Build current C file (Debug)",
            "dependsOrder": "sequence",
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}
